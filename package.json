{
  "name": "estreux",
  "version": "0.3.0",
  "description": "EstreUX (Universal eXpression) — .eux 자연어 중간 소스 → 전 개발 영역(UI/backend/protocol/state machine/data) 코드로 brew. UI 한정 아님.",
  "type": "module",
  "bin": {
    "estreux": "bin/estreux.mjs"
  },
  "files": [
    "bin/",
    "spike/expand.mjs",
    "spike/drift-check.mjs",
    "spike/p4-check.mjs",
    "spike/providers/",
    "spike/notif-toggle.eux",
    "docs/",
    "BREW.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoliEstre/EstreUX.git"
  },
  "keywords": [
    "eux",
    "estre",
    "estreui",
    "estreuv",
    "codegen",
    "brew",
    "scaffolding",
    "llm",
    "ai-native"
  ],
  "scripts": {
    "brew": "node spike/expand.mjs spike/notif-toggle.eux",
    "expand": "node spike/expand.mjs spike/notif-toggle.eux",
    "drift": "node spike/drift-check.mjs spike/notif-toggle.eux",
    "p4": "node spike/p4-check.mjs spike/notif-toggle.eux",
    "spike": "node spike/expand.mjs spike/notif-toggle.eux && node spike/drift-check.mjs spike/notif-toggle.eux",
    "prepare": "git config core.hooksPath .githooks"
  },
  "author": "SoliEstre",
  "license": "Apache-2.0",
  "devDependencies": {
    "fast-check": "^3.23.2"
  }
}
